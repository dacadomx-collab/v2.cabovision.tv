# =============================================================================
# ARCHIVO   : .htaccess (Hot Storage — directorio de tenant)
# PROPÓSITO : Bloquear ejecución de scripts dentro del árbol de uploads
#             ({tenant_id}/{YYYY}/{MM}/{DD}/*.ext, ver api/media_bridge.php).
#             Un atacante que logre subir un .php aquí NUNCA debe poder
#             ejecutarlo — solo servirlo como bytes estáticos o 403.
#
# NOTA (2026-07-31): versión anterior con php_flag/SetHandler/ExecCGI causó
# HTTP 500 en staging (PHP-FPM + AllowOverride restringido). Se simplifica
# a la mínima directiva compatible con Apache 2.4 sin overrides riesgosos.
# =============================================================================

<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|phar|cgi|pl)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|phar|cgi|pl)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
